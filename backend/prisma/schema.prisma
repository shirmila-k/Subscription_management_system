// Brightloop Software - Subscription Management System
// Prisma Schema for MySQL

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
}

enum InvoiceStatus {
  DRAFT
  CONFIGURED
  CONFIRMED
  PAID
  OVERDUE
  VOID
}

enum DiscountType {
  FIXED
  PERCENTAGE
}

enum PaymentTerms {
  IMMEDIATE
  NET15
  NET30
  NET60
}

enum PaymentMethod {
  RAZORPAY
  STRIPE
  CREDIT_CARD
  BANK_TRANSFER
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  passwordHash     String
  name             String
  role             Role      @default(CUSTOMER)
  companyName      String?
  phone            String?
  address          String?
  resetToken       String?
  resetTokenExpiry DateTime?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  subscriptions Subscription[]
  invoices      Invoice[]
  payments      Payment[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model Product {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("Software")
  salesPrice  Decimal  @default(0.00) @db.Decimal(10, 2)
  costPrice   Decimal  @default(0.00) @db.Decimal(10, 2)
  notes       String?  @db.Text
  description String?  @db.Text
  sku         String   @unique
  brand       String?
  category    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variants  ProductVariant[]
  plans     Plan[]
  discounts Discount[]

  @@index([sku])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(uuid())
  productId  String
  name       String
  sku        String   @unique
  attributes Json?
  extraCost  Decimal  @default(0.00) @db.Decimal(10, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product                Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  plans                  Plan[]
  subscriptionItems      SubscriptionItem[]
  quotationTemplateLines QuotationTemplateLine[]

  @@index([productId])
  @@index([sku])
  @@map("product_variants")
}

model Plan {
  id               String           @id @default(uuid())
  productId        String
  variantId        String?
  name             String
  description      String?          @db.Text
  billingFrequency BillingFrequency
  cost             Decimal          @db.Decimal(10, 2)
  currency         String           @default("USD")
  minimumQuantity  Int              @default(1)
  validFrom        DateTime?
  validUntil       DateTime?
  autoClose        Boolean          @default(true)
  autoRenew        Boolean          @default(true)
  pauseAllowed     Boolean          @default(true)
  trialPeriodDays  Int              @default(0)
  gracePeriodDays  Int              @default(7)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant            ProductVariant?     @relation(fields: [variantId], references: [id], onDelete: SetNull)
  subscriptions      Subscription[]
  quotationTemplates QuotationTemplate[]

  @@index([productId])
  @@index([billingFrequency])
  @@index([isActive])
  @@map("plans")
}

model Discount {
  id                String       @id @default(uuid())
  code              String       @unique
  type              DiscountType @default(PERCENTAGE)
  value             Decimal      @db.Decimal(10, 2)
  minQuantity       Int          @default(1)
  minPurchaseAmount Decimal      @default(0.00) @db.Decimal(10, 2)
  startDate         DateTime
  endDate           DateTime
  maxUses           Int?
  usedCount         Int          @default(0)
  productId         String?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  product       Product?       @relation(fields: [productId], references: [id], onDelete: SetNull)
  subscriptions Subscription[]

  @@index([code])
  @@index([productId])
  @@index([isActive])
  @@map("discounts")
}

model QuotationTemplate {
  id                  String                  @id @default(uuid())
  name                String                  @unique
  description         String?                 @db.Text
  planId              String
  validityDays        Int                     @default(15)
  defaultPaymentTerms PaymentTerms            @default(IMMEDIATE)
  defaultNotes        String?                 @db.Text
  isActive            Boolean                 @default(true)
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  plan  Plan                    @relation(fields: [planId], references: [id], onDelete: Restrict)
  lines QuotationTemplateLine[]

  @@index([planId])
  @@index([isActive])
  @@map("quotation_templates")
}

model QuotationTemplateLine {
  id          String   @id @default(uuid())
  templateId  String
  variantId   String?
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  template QuotationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  variant  ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([templateId])
  @@map("quotation_template_lines")
}

model Subscription {
  id                 String             @id @default(uuid())
  subscriptionNumber String             @unique
  customerId         String
  planId             String
  discountId         String?
  status             SubscriptionStatus @default(DRAFT)
  quantity           Int                @default(1)
  unitPrice          Decimal            @db.Decimal(10, 2)
  discountAmount     Decimal            @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal            @db.Decimal(10, 2)
  paymentTerms       PaymentTerms       @default(IMMEDIATE)
  startDate          DateTime?
  expiryDate         DateTime?
  nextBillingDate    DateTime?
  lastBilledDate     DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  quotationNotes     String?            @db.Text
  quotationExpiresAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  customer User               @relation(fields: [customerId], references: [id], onDelete: Restrict)
  plan     Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)
  discount Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  invoices Invoice[]
  items    SubscriptionItem[]

  @@index([customerId])
  @@index([planId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([expiryDate])
  @@map("subscriptions")
}

model SubscriptionItem {
  id             String   @id @default(uuid())
  subscriptionId String
  variantId      String?
  description    String
  quantity       Int      @default(1)
  unitPrice      Decimal  @db.Decimal(10, 2)
  subtotal       Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  subscription Subscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  variant      ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([subscriptionId])
  @@map("subscription_items")
}

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique
  subscriptionId     String?
  customerId         String
  status             InvoiceStatus @default(DRAFT)
  subtotal           Decimal       @db.Decimal(10, 2)
  taxRate            Decimal       @default(0.18) @db.Decimal(5, 2)
  taxAmount          Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  currency           String        @default("USD")
  billingPeriodStart DateTime?
  billingPeriodEnd   DateTime?
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  paidAt             DateTime?
  notes              String?       @db.Text
  pdfUrl             String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  customer     User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  payments     Payment[]
  items        InvoiceItem[]

  @@index([subscriptionId])
  @@index([customerId])
  @@index([status])
  @@index([dueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  taxRate     Decimal  @default(0.18) @db.Decimal(5, 2)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("invoice_items")
}

model Payment {
  id                   String        @id @default(uuid())
  paymentNumber        String        @unique
  invoiceId            String
  customerId           String
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("USD")
  method               PaymentMethod
  status               PaymentStatus @default(PENDING)
  transactionReference String?
  razorpayOrderId      String?
  razorpaySignature    String?
  paymentDate          DateTime      @default(now())
  notes                String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  invoice  Invoice @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  customer User    @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@map("payments")
}
