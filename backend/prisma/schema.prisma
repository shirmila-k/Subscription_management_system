datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum UserRole {
  ADMIN
  STAFF
  CUSTOMER
}

enum BillingFrequency {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  DRAFT
  QUOTATION
  CONFIRMED
  ACTIVE
  PAUSED
  CLOSED
  CANCELLED
}

enum PaymentTerms {
  IMMEDIATE
  NET_15
  NET_30
  NET_60
}

enum InvoiceStatus {
  DRAFT
  CONFIRMED
  PAID
  OVERDUE
  VOID
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum PaymentMethod {
  CREDIT_CARD
  BANK_TRANSFER
  UPI
  RAZORPAY
  STRIPE
  CASH
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

// -------------------------------------------------------------
// USER & AUTH
// -------------------------------------------------------------

model User {
  id                   String    @id @default(uuid())
  email                String    @unique
  passwordHash         String
  role                 UserRole  @default(CUSTOMER)
  firstName            String
  lastName             String
  companyName          String?
  phone                String?
  address              String?
  taxId                String?   // GST/VAT/Tax number
  isActive             Boolean   @default(true)
  resetPasswordToken   String?   @unique
  resetPasswordExpiry  DateTime?
  lastLoginAt          DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  // Relationships
  customerSubscriptions Subscription[] @relation("CustomerSubscriptions")
  managedSubscriptions  Subscription[] @relation("ManagedSubscriptions")
  invoices              Invoice[]
  payments              Payment[]
  auditLogs             AuditLog[]

  @@index([role])
  @@index([email])
  @@map("users")
}

// -------------------------------------------------------------
// PRODUCTS & VARIANTS
// -------------------------------------------------------------

model Product {
  id          String           @id @default(uuid())
  name        String
  code        String           @unique // e.g. PROD-ODOO-CORE
  description String?          @db.Text
  category    String?
  brand       String?          // Brand or suite integration (e.g., Odoo, Brightloop Suite)
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relationships
  variants    ProductVariant[]
  plans       Plan[]

  @@index([isActive])
  @@index([brand])
  @@map("products")
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name            String   // e.g. "Enterprise Edition", "Multi-brand Tier", "Pro Support"
  sku             String   @unique
  priceAdjustment Decimal  @default(0.00) @db.Decimal(10, 2)
  attributes      Json?    // Dynamic custom attributes e.g. { "brandAddon": true, "maxUsers": 50 }
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relationships
  plans           Plan[]

  @@index([productId])
  @@map("product_variants")
}

// -------------------------------------------------------------
// PLANS & PRICING
// -------------------------------------------------------------

model Plan {
  id                 String           @id @default(uuid())
  productId          String
  product            Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId          String?
  variant            ProductVariant?  @relation(fields: [variantId], references: [id], onDelete: SetNull)
  name               String
  code               String           @unique // e.g. PLAN-M-ENTERPRISE
  description        String?          @db.Text
  billingFrequency   BillingFrequency @default(MONTHLY)
  billingCycleDays   Int              @default(30) // 1 (Daily), 7 (Weekly), 30 (Monthly), 365 (Yearly)
  price              Decimal          @db.Decimal(10, 2)
  currency           String           @default("USD")
  minQuantity        Int              @default(1)
  availableFrom      DateTime?
  availableTo        DateTime?
  autoCloseOnExpiry  Boolean          @default(true)
  canPause           Boolean          @default(true)
  autoRenew          Boolean          @default(true)
  trialDays          Int              @default(0)
  isActive           Boolean          @default(true)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Relationships
  subscriptions      Subscription[]

  @@index([productId])
  @@index([billingFrequency])
  @@index([isActive])
  @@map("plans")
}

// -------------------------------------------------------------
// DISCOUNTS & PROMOTIONS
// -------------------------------------------------------------

model Discount {
  id                String         @id @default(uuid())
  code              String         @unique // e.g. PROMO2026, BRIGHT50
  description       String?
  type              DiscountType   @default(PERCENTAGE)
  value             Decimal        @db.Decimal(10, 2) // 15.00 for 15% or 50.00 for $50 fixed
  minQuantity       Int            @default(1)
  minPurchaseAmount Decimal?       @db.Decimal(10, 2)
  maxDiscountAmount Decimal?       @db.Decimal(10, 2) // Ceiling for percentage discounts
  startDate         DateTime       @default(now())
  endDate           DateTime?
  usageLimit        Int?           // Max total redemptions permitted
  timesUsed         Int            @default(0)
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // Relationships
  subscriptions     Subscription[]

  @@index([code])
  @@index([isActive])
  @@map("discounts")
}

// -------------------------------------------------------------
// SUBSCRIPTIONS & LIFECYCLE
// -------------------------------------------------------------

model Subscription {
  id                  String             @id @default(uuid())
  subscriptionNumber  String             @unique // e.g. SUB-2026-0001
  customerId          String
  customer            User               @relation("CustomerSubscriptions", fields: [customerId], references: [id])
  createdById         String?
  createdBy           User?              @relation("ManagedSubscriptions", fields: [createdById], references: [id], onDelete: SetNull)
  planId              String
  plan                Plan               @relation(fields: [planId], references: [id])
  status              SubscriptionStatus @default(DRAFT)
  quantity            Int                @default(1)
  unitPrice           Decimal            @db.Decimal(10, 2)
  discountId          String?
  discount            Discount?          @relation(fields: [discountId], references: [id], onDelete: SetNull)
  discountAmount      Decimal            @default(0.00) @db.Decimal(10, 2)
  taxRate             Decimal            @default(18.00) @db.Decimal(5, 2)
  taxAmount           Decimal            @default(0.00) @db.Decimal(10, 2)
  subtotal            Decimal            @db.Decimal(10, 2)
  totalAmount         Decimal            @db.Decimal(10, 2)
  paymentTerms        PaymentTerms       @default(NET_30)
  
  // Lifecycle Dates
  startDate           DateTime
  nextBillingDate     DateTime?
  expiryDate          DateTime?
  autoRenew           Boolean            @default(true)
  quotationSentAt     DateTime?
  quotationAcceptedAt DateTime?
  confirmedAt         DateTime?
  activatedAt         DateTime?
  pausedAt            DateTime?
  closedAt            DateTime?
  cancellationReason  String?            @db.Text
  notes               String?            @db.Text
  
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  // Relationships
  invoices            Invoice[]
  lifecycleLogs       SubscriptionLifecycleLog[]

  @@index([customerId])
  @@index([status])
  @@index([nextBillingDate])
  @@index([expiryDate])
  @@map("subscriptions")
}

model SubscriptionLifecycleLog {
  id             String             @id @default(uuid())
  subscriptionId String
  subscription   Subscription       @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromStatus     SubscriptionStatus
  toStatus       SubscriptionStatus
  action         String             // e.g. "SENT_QUOTATION", "ACCEPTED_QUOTATION", "CONFIRMED", "ACTIVATED", "PAUSED", "AUTO_CLOSED"
  notes          String?            @db.Text
  performedById  String?
  createdAt      DateTime           @default(now())

  @@index([subscriptionId])
  @@map("subscription_lifecycle_logs")
}

// -------------------------------------------------------------
// INVOICES & BILLING
// -------------------------------------------------------------

model Invoice {
  id                 String        @id @default(uuid())
  invoiceNumber      String        @unique // e.g. INV-2026-0001
  subscriptionId     String
  subscription       Subscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  customerId         String
  customer           User          @relation(fields: [customerId], references: [id])
  status             InvoiceStatus @default(DRAFT)
  issueDate          DateTime      @default(now())
  dueDate            DateTime
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  subtotal           Decimal       @db.Decimal(10, 2)
  taxRate            Decimal       @default(18.00) @db.Decimal(5, 2)
  taxAmount          Decimal       @db.Decimal(10, 2)
  discountAmount     Decimal       @default(0.00) @db.Decimal(10, 2)
  totalAmount        Decimal       @db.Decimal(10, 2)
  amountPaid         Decimal       @default(0.00) @db.Decimal(10, 2)
  balanceDue         Decimal       @db.Decimal(10, 2)
  notes              String?       @db.Text
  pdfPath            String?       // Local file path or cloud URL
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  // Relationships
  items              InvoiceItem[]
  payments           Payment[]

  @@index([customerId])
  @@index([subscriptionId])
  @@index([status])
  @@index([dueDate])
  @@index([issueDate])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  amount      Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// -------------------------------------------------------------
// PAYMENTS & RECONCILIATION
// -------------------------------------------------------------

model Payment {
  id                   String        @id @default(uuid())
  paymentNumber        String        @unique // e.g. PAY-2026-0001
  invoiceId            String
  invoice              Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customerId           String
  customer             User          @relation(fields: [customerId], references: [id])
  amount               Decimal       @db.Decimal(10, 2)
  currency             String        @default("USD")
  paymentMethod        PaymentMethod @default(CREDIT_CARD)
  status               PaymentStatus @default(SUCCESS)
  paymentDate          DateTime      @default(now())
  transactionReference String?       // e.g. Razorpay payment_id, Stripe ch_xxx, Bank UTR
  gatewayResponse      Json?         // Webhook or gateway raw response payload
  notes                String?       @db.Text
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
  @@index([paymentDate])
  @@map("payments")
}

// -------------------------------------------------------------
// AUDIT LOGS
// -------------------------------------------------------------

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entity    String   // e.g. "SUBSCRIPTION", "INVOICE", "PAYMENT", "DISCOUNT"
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
