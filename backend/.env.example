PORT=5000
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/brightloop_subscriptions"

# JWT Auth
JWT_SECRET="brightloop_super_secret_jwt_key_2026_production_ready"
JWT_EXPIRES_IN="7d"

# App & CORS
FRONTEND_URL="http://localhost:5173"
COMPANY_NAME="Brightloop Software Inc."
COMPANY_EMAIL="billing@brightloop.com"
COMPANY_TAX_ID="US-EIN-987654321"

# Automated Billing & Cron Defaults
BILLING_TAX_PERCENT=18.00
CRON_SCHEDULE_BILLING="0 2 * * *" # Daily at 2:00 AM
CRON_SCHEDULE_REMINDERS="0 8 * * *" # Daily at 8:00 AM
CRON_SCHEDULE_LIFECYCLE="0 0 * * *" # Daily at midnight
CRON_SCHEDULE_NOTIFICATIONS="* * * * *" # Every minute pending notification worker

# Email Notification & SMTP Provider Settings (Phase 6)
# Live sending is disabled by default (safe development simulation mode)
EMAIL_ENABLED="false"
EMAIL_HOST="smtp.mailtrap.io"
EMAIL_PORT=587
EMAIL_SECURE="false"
EMAIL_USER="your-smtp-username"
EMAIL_PASSWORD="your-smtp-password"
EMAIL_FROM="Brightloop Billing <billing@brightloop.com>"
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_BATCH_SIZE=25
